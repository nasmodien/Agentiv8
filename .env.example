# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentiv8"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Provider - OpenRouter (primary — powers all AI responses)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# AI Provider - Anthropic (fallback / legacy — optional if using OpenRouter)
ANTHROPIC_API_KEY="sk-ant-..."

# AI Provider - OpenAI (for embeddings / Pinecone — optional)
OPENAI_API_KEY="sk-..."

# Pinecone Vector DB (for Knowledge Base)
PINECONE_API_KEY=""
PINECONE_INDEX="agentiv8-kb"

# Hostaway Integration
HOSTAWAY_WEBHOOK_SECRET=""

# App URL (for webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
